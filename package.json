{
  "name": "weread-desktop",
  "version": "1.0.0",
  "description": "WeChat Read desktop app built with Pake (Tauri + Rust)",
  "scripts": {
    "build": "npx pake \"https://weread.qq.com/\" --name \"WeChatRead\" --icon \"icon.ico\" --width 1280 --height 800 --hide-title-bar --inject \"inject/pake-custom.js\"",
    "build:debug": "npx pake \"https://weread.qq.com/\" --name \"WeChatRead\" --icon \"icon.ico\" --width 1280 --height 800 --hide-title-bar --inject \"inject/pake-custom.js\" --debug"
  },
  "keywords": ["weread", "wechat-read", "desktop", "pake", "tauri"],
  "license": "MIT",
  "devDependencies": {
    "pake-cli": "^3.11.4"
  }
}
